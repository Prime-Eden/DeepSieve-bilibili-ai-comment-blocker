{
  "manifest_version": 3,
  "name": "DeepSieve · AI 评论过滤",
  "short_name": "DeepSieve",
  "version": "2.16.9",
  "description": "过滤 B 站评论区里的 AI 评论和机器人账号，命中的评论直接隐藏。数据只存在本机。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DeepSieve · AI 评论过滤",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "clear": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "清理本页已识别的大肥鱼"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*",
        "https://message.bilibili.com/*",
        "https://passport.bilibili.com/*",
        "https://member.bilibili.com/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*",
        "https://message.bilibili.com/*",
        "https://passport.bilibili.com/*",
        "https://member.bilibili.com/*"
      ],
      "js": [
        "src/icons.js",
        "src/storage.js",
        "src/detector.js",
        "src/counter.js",
        "src/comments.js",
        "src/space.js",
        "src/bubble.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*"
  ]
}